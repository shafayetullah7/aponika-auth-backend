NODE_ENV=development
PORT=3010
APP_EXTERNAL_PORT=3010
APP_NAME=aponika-auth

# Host dev (pnpm start:dev + pnpm docker:db): localhost + mapped port
# Docker dev (pnpm docker:dev): compose overrides DB_HOST=db, DB_PORT=5432 on the app service
DB_HOST=localhost
DB_PORT=5436
DB_USER=aponika_auth
DB_PASSWORD=change_me
DB_NAME=aponika_auth
DB_SSL=false
DB_EXTERNAL_PORT=5436

CORS_ORIGINS=http://localhost:3011,http://localhost:3012

# Docker Compose
COMPOSE_PROJECT_NAME=aponika-auth
DOCKER_BUILD_TARGET=development
