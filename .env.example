NODE_ENV=development
PORT=3010
APP_EXTERNAL_PORT=3010
APP_NAME=aponika-auth

# === Database ===
DB_HOST=db
DB_PORT=5432
DB_USER=aponika_auth
DB_PASSWORD=change_me
DB_NAME=aponika_auth
DB_SSL=false

# === Docker Compose ===
COMPOSE_PROJECT_NAME=aponika-auth
DB_EXTERNAL_PORT=5436
DOCKER_BUILD_TARGET=development

CORS_ORIGINS=http://localhost:3011,http://localhost:3012

# OIDC issuer (discovery base URL — no trailing slash)
OIDC_ISSUER=http://localhost:3010
OIDC_ACCESS_TOKEN_TTL=900
# OIDC refresh token lifetime in seconds (default 7 days)
OIDC_REFRESH_TOKEN_TTL=604800
# JWT access token audience / resource indicator (Byte Forge API in dev)
OIDC_DEFAULT_RESOURCE=http://localhost:3005
# RS256 private key PEM path for JWKS signing. Leave empty in dev (library dev keystore).
# Generate: bash scripts/generate-oidc-signing-key.sh
OIDC_JWKS_PRIVATE_KEY_PATH=

# Session cookies (admin + user BFF — ADR-002)
COOKIE_DOMAIN=localhost
SESSION_MAX_AGE=604800000

# Admin session JWT (platform operator console)
JWT_ADMIN_ACCESS_SECRET=dev-only-change-me-admin-access-secret-32chars-min
JWT_ADMIN_ACCESS_EXP=15m
JWT_ADMIN_REFRESH_SECRET=dev-only-change-me-admin-refresh-secret-32chars-min
JWT_ADMIN_REFRESH_EXP=7d

# End-user session JWT (auth frontend BFF)
JWT_USER_ACCESS_SECRET=dev-only-change-me-user-access-secret-32chars-min
JWT_USER_ACCESS_EXP=15m
JWT_USER_REFRESH_SECRET=dev-only-change-me-user-refresh-secret-32chars-min
JWT_USER_REFRESH_EXP=7d

# Admin registration OTP gatekeeper (F5)
ADMIN_REGISTRATION_OTP_EMAIL=gatekeeper@example.com

# === Mail Configuration (byte-forge-auth parity) ===
MAIL_PROVIDER=console
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Aponika
MAIL_FROM_EMAIL=noreply@aponika.com

AUTH_FRONTEND_URL=http://localhost:3011
